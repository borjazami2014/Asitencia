# ==============================================================
# ASISTRACK - Variables de Entorno de Ejemplo
# ==============================================================

# Entorno de ejecución (development | production)
NODE_ENV=development

# Puerto del servidor backend
PORT=3000

# Clave secreta para firma de Tokens JWT (Sesiones de autenticación)
JWT_SECRET=super_secreto_asistrack_seguro_2026_jwt_token_key

# --------------------------------------------------------------
# CONEXIÓN A BASE DE DATOS POSTGRESQL (Render o Local)
# --------------------------------------------------------------
# En Render, la variable DATABASE_URL se genera automáticamente al vincular la base de datos PostgreSQL.
# Ejemplo Render / Neon / Supabase:
# DATABASE_URL=postgres://usuario:password@host.oregon-postgres.render.com/asistrack_db

# Parámetros individuales opcionales si no se utiliza DATABASE_URL:
# PGHOST=localhost
# PGPORT=5432
# PGUSER=postgres
# PGPASSWORD=tu_password
# PGDATABASE=asistrack
# PGSSLMODE=require
